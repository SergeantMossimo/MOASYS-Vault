# ─────────────────────────────────────────────
# MOASYS-Vault .gitignore
# ─────────────────────────────────────────────

# Output files — generated locally by running the scanner.
# Each user generates their own from their own media library.
output/

# Probe cache — ffprobe results keyed by path|mtime|size.
# Always rebuildable from the media library, never committed.
cache/

# Rules — two-tier model.
#
# rules/<type>.yaml is the committed default snapshot (shipped with the
# repo, mirrors what the code uses if no file existed). Edit it to change
# the project-wide defaults for everyone using this checkout.
#
# rules/<type>.local.yaml is your personal override layer — gitignored so
# library-specific values (quality_thresholds, custom ignored_season_names,
# extra categories) never end up in the repo.
rules/*.local.yaml

# ignored/<type>.yaml is the per-user ignore list — flat list of path
# prefixes that silence warnings on specific files / folders / shows the
# user can't or doesn't want to fix. The `.yaml.example` reference files
# stay committed.
ignored/*.yaml
!ignored/*.yaml.example

# Secrets — TMDB API key etc. NEVER commit this file.
.secrets.json

# TypeScript compiled output
dist/

# Node modules
node_modules/

# Prettier cache
.prettier-cache

# ESLint cache
.eslintcache

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# VS Code
.vscode/