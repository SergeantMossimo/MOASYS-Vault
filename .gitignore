# ─────────────────────────────────────────────
# MOASYS-Vault .gitignore
# ─────────────────────────────────────────────

# Output files — generated locally by running the scanner.
# Each user generates their own from their own media library.
output/

# Probe cache — ffprobe results keyed by path|mtime|size.
# Always rebuildable from the media library, never committed.
cache/

# Rules — single file per media type at rules/<type>.yaml.
#
# These ARE committed in this repo because they capture this library's
# naming conventions. If you fork the project and your overrides are
# personal (not meant to be shared), un-comment the line below to keep
# them local-only.
#
# rules/*.yaml

# Secrets — TMDB API key etc. NEVER commit this file.
.secrets.json

# TypeScript compiled output
dist/

# Node modules
node_modules/

# Prettier cache
.prettier-cache

# ESLint cache
.eslintcache

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# VS Code
.vscode/