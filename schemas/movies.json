{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moasys.local/vault/schemas/movies.json",
  "title": "MOASYS-Vault — movies.json",
  "description": "The movies catalog. One entry per movie + edition. Generated by `npm run movies`.",
  "type": "array",
  "items": { "$ref": "#/$defs/MovieOutput" },
  "$defs": {
    "MovieOutput": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1888
        },
        "edition": {
          "type": ["string", "null"],
          "description": "Edition tag from filename ({edition-Name}), or null when no edition is present."
        },
        "versions": {
          "type": "array",
          "items": { "$ref": "common.json#/$defs/Version" },
          "minItems": 1
        }
      },
      "required": ["title", "year", "edition", "versions"],
      "additionalProperties": false
    }
  }
}
