{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moasys.local/vault/schemas/audiobooks.json",
  "title": "MOASYS-Vault — audiobooks.json",
  "description": "The audiobooks catalog. One entry per book, keyed by title only — different authors with the same title collide intentionally. Generated by `npm run audiobooks`.",
  "type": "array",
  "items": { "$ref": "#/$defs/BookOutput" },
  "$defs": {
    "BookOutput": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "authors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "description": "Always at least one entry. Multi-author folders ('Author1, Author2[, and Author3]') are parsed into the array."
        },
        "chapter_count": { "type": "integer", "minimum": 0 },
        "versions": {
          "type": "array",
          "items": { "$ref": "common.json#/$defs/Version" },
          "minItems": 1
        }
      },
      "required": ["title", "authors", "chapter_count", "versions"],
      "additionalProperties": false
    }
  }
}
