# ─────────────────────────────────────────────────────────────────────────────
# MOASYS-Vault — Movies ignore list (EXAMPLE)
# ─────────────────────────────────────────────────────────────────────────────
#
# A "do not warn me about this" list for your movie library. Anything you put
# here gets silently dropped from output/movies/warnings.json on every run.
#
# How to use this file:
#   1. Copy this file to `ignored/movies.yaml` (drop the `.example` suffix).
#      The real `movies.yaml` is gitignored so your personal decisions don't
#      end up in version control.
#   2. Add path prefixes below — one per line.
#   3. Re-run `npm run movies`. Matching warnings disappear from the output.
#
# Two entry shapes — pick whichever fits each case:
#
#   # 1. Path-only (a bare string) — silences EVERY warning under this path.
#   - UHD/Some Movie (2020)
#
#   # 2. Type-scoped (an object) — silences only the listed warning types
#   #    under this path. Other warnings on the same path stay visible.
#   - path: UHD/Some Movie (2020)
#     types:
#       - warn_tmdb_year_mismatch
#
# Matching is case-insensitive and forward-slash-normalized, so the same
# file works on Windows (backslashes) and macOS/Linux (forward slashes).
#
# Get the paths to add from output/movies/warnings.json and
# output/movies/validation-warnings.json. Get the warning types from the
# `type` field of each entry, or from rules/movies.yaml under `checks`.
# ─────────────────────────────────────────────────────────────────────────────


# Silence everything under a category folder
# (Useful for "Other UHD" / "Other HD" / "Other SD" — categories you keep
# around but don't actively curate.)
# - Other UHD
# - Other SD


# Silence one specific movie
# (Drops every warning inside this movie's folder — quality mismatch, TMDB
# no-match, naming warnings, etc.)
# - UHD/Some Movie (2020)
# - HD/Old Concert Film (1985)


# Silence one specific file
# (Pin-point: just one file. Useful when a specific edition has a legitimate
# warning you've decided to accept.)
# - UHD/Blade Runner (1982)/Blade Runner (1982) {edition-Final Cut}.mp4


# Silence one warning type for a specific path
# (Most precise option. The example below silences ONLY the TMDB year-
# mismatch warning — other warnings on the same path stay visible.)
# - path: UHD/Casablanca (1942)
#   types:
#     - warn_tmdb_year_mismatch
